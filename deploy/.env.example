# =============================================================================
# DeepAnalyze 内网部署环境变量
# =============================================================================
# 复制本文件为 .env 并根据需要修改
# =============================================================================

# 服务端口
BACKEND_PORT=21000
FRONTEND_PORT=3000

# PostgreSQL
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=deepanalyze
PG_USER=deepanalyze
PG_PASSWORD=deepanalyze_dev

# Ollama（可选，使用本地嵌入模型时启用）
OLLAMA_PORT=11434
